          },
          "refId": "A",
          "expr": "sum(gamificacao_outbox_pendentes)",
          "legendFormat": "outbox (banco)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rabbitmq_queue_messages_ready)",
